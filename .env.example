# Neon Postgres connection string (same database as the storefront)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Password used to sign in to the admin panel
ADMIN_PASSWORD=change-me
# Random string used to sign the session cookie
AUTH_SECRET=generate-a-long-random-string
# Cloudinary (for in-admin image uploads): cloud name + an UNSIGNED upload preset
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=norfu-unsigned
